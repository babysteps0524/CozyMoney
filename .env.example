# Google AdSense
# 발급받은 실제 값으로 교체한 뒤 Cloudflare Pages 환경변수에도 동일하게 등록 필수
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_CALCULATOR=XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_TOOL=XXXXXXXXXXXXXXXX

# 사이트 URL
PUBLIC_SITE_URL=https://cozymoney.kr

# Brevo 이메일 발송
# 실제 API 키는 로컬 .env와 Cloudflare Pages 환경변수에 안전하게 등록
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXX
BREVO_FROM_EMAIL=no-reply@cozymoney.kr
BREVO_FROM_NAME=CozyMoney 코지머니

# 관리자 이메일 (문의 알림 수신) 
ADMIN_EMAIL=admin@example.com
