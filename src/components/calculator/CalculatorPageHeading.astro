---
interface Props {
  title: string;
  description: string;
  category: string;
}

const { title, description, category } = Astro.props;
---

<header max-w="3xl" mb="8" aria-labelledby="calculator-page-title">
  <p m="0" text="sm" font="700" text-primary>
    {category}
  </p>
  <h1
    id="calculator-page-title"
    m="0"
    mt="2"
    text="3xl md:4xl"
    font="800"
    tracking-tight
  >
    {title}
  </h1>
  <p m="0" mt="4" text="base md:lg text-muted dark:dark-text-muted" leading="7">
    {description}
  </p>
</header>
