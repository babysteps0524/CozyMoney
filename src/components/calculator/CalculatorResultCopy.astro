---
interface Props {
  targets: string;
}

const { targets } = Astro.props;
---

<div mt="4" flex justify-end>
  <button
    type="button"
    class="cm-button-secondary w-full min-w-32 px-4 py-2.5 sm:w-auto"
    data-calculator-copy
    data-copy-targets={targets}
    aria-live="polite"
  >
    결과 복사
  </button>
</div>

<script>
  import { bindCalculatorResultCopy } from '../../lib/calculator/copy-result';

  bindCalculatorResultCopy(document);
</script>
