---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import AdSlot from '../../components/shared/AdSlot.astro';
---

<BaseLayout
  title="문의하기 | CozyMoney 코지머니"
  description="CozyMoney 서비스와 계산기, 생활도구에 대한 문의를 접수하고 답변을 받을 수 있습니다. 문의 내용은 이메일로 확인해 드립니다."
  canonical="https://cozymoney.kr/contact/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <article max-w="3xl" mx="auto">
      <header mb="8">
        <p m="0" text="sm" font="700" text-primary>
          CONTACT
        </p>
        <h1 m="0" mt="2" text="3xl md:4xl" font="800">
          문의하기
        </h1>
        <p m="0" mt="4" leading="7" text="text-muted dark:dark-text-muted">
          사이트 이용 중 오류를 발견했거나 계산기·생활도구에 대한 의견이 있다면
          문의해 주세요. 접수된 문의는 이메일로 답변을 드립니다.
        </p>
      </header>

      <section class="cm-card" p="5 md:7">
        <h2 m="0" text="xl" font="750" mb="4">
          이메일 문의
        </h2>
        <p m="0" mb="5" leading="7" text="text-muted dark:dark-text-muted">
          문의 내용을 가능한 한 구체적으로 작성해 주세요. 오류 문의라면 사용한
          페이지, 입력 조건, 기대한 결과와 실제 결과를 함께 알려주시면 확인에
          도움이 됩니다.
        </p>

        <form id="inquiry-form">
          <div mb="5">
            <label
              for="inquiry-name"
              block
              mb="2"
              text="sm font-700 text-gray-900 dark:dark-text"
            >
              이름
            </label>
            <input
              id="inquiry-name"
              name="inquiry-name"
              type="text"
              placeholder="홍길동"
              w="full"
              p="3.5"
              rounded="lg"
              border="1"
              border="border dark:dark-border"
              bg="white dark:dark-surface"
              text="text-gray-900 dark:dark-text"
              text="base"
              required
              minlength="1"
              maxlength="100"
            />
          </div>

          <div mb="5">
            <label
              for="inquiry-email"
              block
              mb="2"
              text="sm font-700 text-gray-900 dark:dark-text"
            >
              이메일 주소
            </label>
            <input
              id="inquiry-email"
              name="inquiry-email"
              type="email"
              placeholder="example@example.com"
              w="full"
              p="3.5"
              rounded="lg"
              border="1"
              border="border dark:dark-border"
              bg="white dark:dark-surface"
              text="text-gray-900 dark:dark-text"
              text="base"
              required
            />
          </div>

          <div mb="5">
            <label
              for="inquiry-subject"
              block
              mb="2"
              text="sm font-700 text-gray-900 dark:dark-text"
            >
              문의 제목
            </label>
            <input
              id="inquiry-subject"
              name="inquiry-subject"
              type="text"
              placeholder="계산기 오류를 제보해요"
              w="full"
              p="3.5"
              rounded="lg"
              border="1"
              border="border dark:dark-border"
              bg="white dark:dark-surface"
              text="text-gray-900 dark:dark-text"
              text="base"
              required
              minlength="1"
              maxlength="200"
            />
          </div>

          <div mb="5">
            <label
              for="inquiry-message"
              block
              mb="2"
              text="sm font-700 text-gray-900 dark:dark-text"
            >
              문의 내용
            </label>
            <textarea
              id="inquiry-message"
              name="inquiry-message"
              rows="6"
              placeholder="문의 내용을 구체적으로 적어 주세요."
              w="full"
              p="3.5"
              rounded="lg"
              border="1"
              border="border dark:dark-border"
              bg="white dark:dark-surface"
              text="text-gray-900 dark:dark-text"
              text="base"
              required
              minlength="1"
              maxlength="2000"
            ></textarea>
          </div>

          <button
            type="submit"
            w="full"
            px="5"
            py="4"
            rounded="xl"
            bg="primary"
            text="white"
            font="700"
            text="base"
            hover="opacity-90"
            active="opacity-70"
          >
            문의 전송하기
          </button>

          <div
            id="inquiry-status"
            role="status"
            aria-live="polite"
            mt="4"
            p="3.5"
            rounded="lg"
            text="sm"
            hidden
          ></div>
        </form>
      </section>

      <AdSlot slot="contact" />

      <section
        mt="8"
        rounded="2xl"
        border="1 border dark:dark-border"
        bg="surface-muted dark:dark-surface-muted"
        p="5"
      >
        <h2 m="0" text="sm" font="750">
          문의 시 개인정보 주의
        </h2>
        <p m="0" mt="2" text="sm text-muted dark:dark-text-muted" leading="7">
          주민등록번호, 계좌번호, 카드번호, 비밀번호 등 민감하거나 불필요한
          개인정보를 이메일로 보내지 마세요.
        </p>
      </section>
    </article>
  </main>
  <Footer />

  <script>
    const form = document.getElementById('inquiry-form')!;
    const messageEl = document.getElementById('inquiry-status')!;

    function setMessage(text: string, type: 'success' | 'error') {
      messageEl.hidden = false;
      messageEl.textContent = text;
      messageEl.className =
        'mt-4 p-3.5 rounded-lg text-sm ' +
        (type === 'success'
          ? 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400'
          : 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400');
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const formData = new FormData(form as HTMLFormElement);
      const body = {
        name: formData.get('inquiry-name'),
        email: formData.get('inquiry-email'),
        subject: formData.get('inquiry-subject'),
        message: formData.get('inquiry-message'),
      };

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = true;
      }
      messageEl.hidden = true;

      try {
        const res = await fetch('/api/contact/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const errorData = await res.json().catch(() => ({}));
          throw new Error(errorData.error || '문의 전송에 실패했습니다.');
        }

        setMessage(
          '문의가 접수되었습니다. 확인 메일 발송을 시도했습니다. 메일이 오지 않으면 스팸함도 확인해 주세요.',
          'success',
        );
        (form as HTMLFormElement).reset();
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        setMessage(msg, 'error');
      } finally {
        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      }
    });
  </script>
</BaseLayout>
