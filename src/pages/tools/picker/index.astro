---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/shared/Header.astro';
import Footer from '../../../components/shared/Footer.astro';
import ToolShell from '../../../components/tool/ToolShell.astro';
---

<BaseLayout
  title="랜덤 추첨기 | CozyMoney 코지머니"
  description="입력한 목록에서 하나의 항목을 무작위로 추첨합니다."
  canonical="https://cozymoney.kr/tools/picker/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        TOOLS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        랜덤 추첨기
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg text-muted dark:dark-text-muted"
        leading="7"
      >
        입력한 목록에서 하나의 항목을 무작위로 추첨합니다.
      </p>
    </header>
    <ToolShell
      kind="picker"
      title="랜덤 추첨기"
      description="이름, 항목, 선택지를 한 줄씩 입력하면 무작위로 하나를 선택합니다."
    />
  </main>
  <Footer />
</BaseLayout>
