      ],
      [
        'DTI 계산기',
        '소득 대비 주택담보대출 관련 상환부담을 계산합니다.',
        '/calculators/dti/',
      ],
    ],
  },
  {
    title: '급여·노동',
    description: '급여와 근로에 관련된 계산기',
    items: [
      [
        '연봉 계산기',
        '연봉을 기준으로 월 급여와 시급을 계산합니다.',
        '/calculators/salary/',
      ],
      [
        '월급 계산기',
        '연봉이나 월급을 입력해 예상 월 실수령액을 계산합니다.',
        '/calculators/monthly-salary/',
      ],
      [
        '시급 계산기',
        '시급·일급·주급·월급·연봉과 주휴·연장수당을 반영합니다.',
        '/calculators/hourly-wage/',
      ],
      [
        '퇴직금 계산기',
        '월 평균임금과 근속기간으로 퇴직금을 단순 추정합니다.',
        '/calculators/severance/',
      ],
      [
        '주휴수당 계산기',
        '시급과 주 소정근로시간을 기준으로 주휴수당을 계산합니다.',
        '/calculators/weekly/',
      ],
      [
        '연차수당 계산기',
        '통상임금과 미사용 연차를 기준으로 연차수당을 계산합니다.',
        '/calculators/vacation/',
      ],
      [
        '실업급여 계산기',
        '평균임금과 예상 지급일수로 구직급여를 단순 추정합니다.',
        '/calculators/unemployment/',
      ],
    ],
  },
  {
    title: '생활 계산',
    description: '일상에서 자주 사용하는 기본 계산',
    items: [
      [
        '퍼센트 계산기',
