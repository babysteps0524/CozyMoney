      ],
      [
        '전세대출 이자 계산기',
        '보증금과 대출비율, 금리로 1년 이자를 계산합니다.',
        '/calculators/leaseLoan/',
      ],
      [
        '법무사 보수 계산기',
        '부동산 등기 과세표준을 기준으로 법무사 기본보수와 인지·증지 비용을 계산합니다.',
        '/calculators/legal-scrivener/',
      ],
    ],
  },
];
---

<BaseLayout
  title="계산기 | CozyMoney 코지머니"
  description="대출·예적금 이자부터 연봉 실수령액, 주휴수당, 세금, 부동산 거래 비용까지 목적에 맞는 계산기를 찾아 예상 금액과 계산 기준을 확인하세요."
  canonical="https://cozymoney.kr/calculators/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        CALCULATORS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        필요한 계산기를 찾아보세요
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg text-muted dark:dark-text-muted"
        leading="7"
      >
        금융, 급여·노동, 세금, 부동산 계산기를 한곳에서 이용할 수 있습니다.
      </p>
    </header>
    <div flex="~ col" gap="10 md:12">
      {categories.map((category, index) => (
        <>
          <section>
            <div mb="4 md:5">
              <h2 m="0" text="xl md:2xl" font="750">
                {category.title}
              </h2>
              <p m="0" mt="1" text="sm text-muted dark:dark-text-muted">
                {category.description}
              </p>
            </div>
            <div grid="~ cols-1 sm:cols-2 lg:cols-3" gap="3 md:4">
              {category.items.map(([title, description, href]) => (
                <a
                  href={href}
                  class="cm-card-interactive"
                  p="5 md:6"
                  no-underline
                >
                  <div flex="~" items-center justify-between gap="3">
                    <h3 m="0" text="lg text dark:dark-text" font="750">
                      {title}
                    </h3>
                    <span text="text-subtle dark:dark-text-subtle">→</span>
                  </div>
                  <p
                    m="0"
                    mt="2"
                    text="sm text-muted dark:dark-text-muted"
                    leading="6"
                  >
                    {description}
                  </p>
                </a>
              ))}
            </div>
          </section>
          {index === 1 ? (
            <AdSlot
              slot={import.meta.env.PUBLIC_ADSENSE_SLOT_LIST_MID || ''}
              label="광고"
            />
          ) : null}
        </>
      ))}
    </div>
    <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_LIST || ''} />
  </main>
  <Footer />
</BaseLayout>
