---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';

const pageTitle = '로그아웃 | CozyMoney 코지머니';
const pageDescription = '로그인 상태를 종료하고 비회원 화면으로 돌아갑니다.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://cozymoney.kr/logout/"
  noindex
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <article
      class="cm-card"
      p="5 md:7"
      max-w="md"
      mx="auto"
      text-align="center"
    >
      <p m="0" text="sm" font="700" text-primary>
        LOG OUT
      </p>
      <h1 m="0" mt="2" text="2xl md:3xl" font="800" tracking-tight>
        로그아웃
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg text-muted dark:dark-text-muted"
        leading="7"
      >
        로그인 상태를 안전하게 종료합니다.
      </p>
      <div flex="~ col" gap="3" mt="8">
        <button
          id="logout-confirm"
          type="button"
          class="cm-button-primary"
          px="6"
          py="3.5"
          text="base"
          w="full sm:auto"
        >
          로그아웃하기
        </button>
        <a
          href="/login/"
          class="cm-button-secondary"
          px="6"
          py="3.5"
          text="base"
          w="full sm:auto"
          no-underline
        >
          로그인 페이지로 돌아가기
        </a>
      </div>
    </article>
  </main>
  <Footer />
  <script>
    (function () {
      const API_BASE = '';
      const btn = document.getElementById(
        'logout-confirm',
      ) as HTMLButtonElement;

      btn.addEventListener('click', async () => {
        try {
          const res = await fetch(`${API_BASE}/api/auth/logout`, {
            method: 'POST',
            credentials: 'include',
          });
          if (res.ok) {
            const msg = document.createElement('p');
            msg.className =
              'm-0 mt-4 text-sm text-success-text dark:text-dark-success-text';
            msg.textContent = '로그아웃되었습니다.';
            btn.closest('article')?.appendChild(msg);
            btn.disabled = true;
            btn.textContent = '완료';
          } else {
            btn.textContent = '다시 시도';
          }
        } catch {
          btn.textContent = '서버 오류';
        }
      });
    })();
  </script>
</BaseLayout>
