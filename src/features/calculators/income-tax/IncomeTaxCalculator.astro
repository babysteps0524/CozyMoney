---
import CalculatorResultCopy from '../../../components/calculator/CalculatorResultCopy.astro';
---

<section class="cm-card" data-income-tax-calculator p="5 md:7">
  <div mb="6">
    <p m="0" text="sm" font="700" text-primary>
      2026 TAX CALCULATOR
    </p>
    <h2 m="0" mt="1" text="xl md:2xl" font="800">
      종합소득세 계산
    </h2>
    <p m="0" mt="2" text="sm text-muted dark:dark-text-muted" leading="6">
      사업·근로·연금·이자·배당·기타소득과 주요 소득공제·세액공제·기납부세액을
      입력해 예상 납부세액을 계산합니다.
    </p>
  </div>

  <div id="income-tax-fields" grid="~ cols-1 lg:cols-2" gap="4"></div>

  <div mt="6" rounded="2xl" bg="primary/10 dark:dark-primary-surface" p="5">
    <p m="0" text="sm text-muted dark:dark-text-muted">
      예상 납부(환급)할 소득세
    </p>
    <div
      id="income-tax-result"
      aria-live="polite"
      aria-atomic="true"
      mt="2"
      text="2xl md:3xl"
      font="800"
      text-primary
    >
      -
    </div>
    <p
      id="income-tax-summary"
      m="0"
      mt="3"
      class="cm-help-text"
      text="sm"
      leading="7"
    ></p>
  </div>

  <div id="income-tax-breakdown" mt="4" grid="~ cols-1 md:cols-2" gap="3"></div>
  <CalculatorResultCopy targets="#income-tax-result, #income-tax-summary, #income-tax-breakdown" />

  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button
      id="income-tax-calculate"
      type="button"
      class="cm-button-primary"
      py="3"
    >
      계산하기
    </button>
    <button
      id="income-tax-reset"
      type="button"
      class="cm-button-secondary"
      py="3"
    >
      초기화
    </button>
  </div>

  <div mt="8" grid="~ cols-1 lg:cols-2" gap="4">
    <section
      rounded="2xl"
      border="1 border dark:dark-border"
      bg="surface-muted dark:dark-surface-muted"
      p="5"
    >
      <h3 m="0" text="sm" font="750">
        이번 개선에서 반영한 항목
      </h3>
      <ul
        m="0"
        mt="3"
        pl="5"
        text="sm text-muted dark:dark-text-muted"
        leading="7"
      >
        <li>사업·근로·연금·이자·배당·기타소득을 합산합니다.</li>
        <li>근로소득공제와 연금소득공제를 자동 계산합니다.</li>
        <li>인적공제, 연금보험료·특별소득공제를 반영합니다.</li>
        <li>8개 종합소득세율 구간(6%~45%)과 누진공제를 적용합니다.</li>
        <li>
          근로소득·자녀·연금계좌·보험·의료·교육·월세 관련 세액공제를 계산합니다.
        </li>
        <li>
          원천징수세액·기납부세액·가산세를 반영해 납부 또는 환급 예상액을
          표시합니다.
        </li>
      </ul>
    </section>

    <section
      rounded="2xl"
      border="1 border dark:dark-border"
      bg="surface-muted dark:dark-surface-muted"
      p="5"
    >
      <h3 m="0" text="sm" font="750">
        계산 기준과 한계
      </h3>
      <p m="0" mt="3" text="sm text-muted dark:dark-text-muted" leading="7">
        기준 사이트의 종합소득세 계산 흐름을 참고해 주요 항목을 단순화한
        모의계산입니다. 사업소득은 총수입금액·업종코드·기준경비율·단순경비율
        대신 사용자가 계산한 사업소득금액을 입력하도록 구성했습니다. 금융소득의
        종합과세·분리과세, 배당가산, 각종 조세특례와 복잡한 감면은 모두 자동
        판정하지 않습니다.
      </p>
    </section>
  </div>

  <section
    mt="4"
    rounded="2xl"
    border="1 danger-text/20 dark:border-dark-border"
    bg="danger-surface dark:dark-danger-surface"
    p="5"
  >
    <h3 m="0" text="sm" font="750">
      주의사항
    </h3>
    <ul
      m="0"
      mt="3"
      pl="5"
      text="sm text-muted dark:dark-text-muted"
      leading="7"
    >
      <li>2026년 귀속 기준을 중심으로 한 참고용 모의계산입니다.</li>
      <li>
        실제 신고에서는 소득의 과세·비과세·분리과세 여부와 각 공제의 요건을
        개별적으로 확인해야 합니다.
      </li>
      <li>
        사업소득의 필요경비와 금융소득 종합과세 여부를 자동 판정하지 않으므로
        입력한 소득금액에 따라 결과가 달라집니다.
      </li>
      <li>
        세법 개정과 개인별 조건에 따라 국세청·홈택스 신고 결과와 차이가 발생할
        수 있습니다.
      </li>
    </ul>
  </section>
</section>

<script>
  import { calculateIncomeTax, type IncomeTaxInput } from './income-tax';
  import { bindCalculatorInputs } from '../../../lib/calculator/runtime';
  import { readCalculatorNumber } from '../../../lib/calculator/dom';

  const root = document.querySelector<HTMLElement>(
    '[data-income-tax-calculator]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#income-tax-fields')!;
    const result = root.querySelector<HTMLElement>('#income-tax-result')!;
    const summary = root.querySelector<HTMLElement>('#income-tax-summary')!;
    const breakdown = root.querySelector<HTMLElement>('#income-tax-breakdown')!;

    const money = (value: number) =>
      Math.round(value).toLocaleString('ko-KR') + '원';
    const number = (id: string) => readCalculatorNumber(root, id);

    const field = (
      id: string,
      label: string,
      value = '0',
      suffix = '원',
      step = '10000',
    ) => /* html */ `<div class="cm-field">
      <label class="cm-label" for="${id}">${label}</label>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="${label} 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input ${suffix ? 'pr-12' : ''}"
            id="${id}"
            type="text"
            inputmode="numeric"
            value="${value}"
            data-default-value="${value}"
            data-number-input
            data-step="${step}"
            data-min="0"
            data-decimal="false"
          />${suffix
            ? /* html */ `<span
                class="absolute right-4 top-1/2 -translate-y-1/2"
                text="sm text-muted dark:dark-text-muted"
                >${suffix}</span
              >`
            : ''}
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="${label} 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </div>`;

    fields.innerHTML =
      /* html */ `<section class="lg:col-span-2" rounded="2xl" border="1 border dark:dark-border" p="4 md:5"><h3 m="0" text="base" font="750">① 소득 입력</h3><div grid="~ cols-1 md:cols-2" gap="4" mt="4">${field('businessIncome', '사업소득금액', '0')}${field('wageIncome', '총급여액', '50000000')}${field('pensionIncome', '총 연금액', '0')}${field('interestIncome', '이자소득금액', '0')}${field('dividendIncome', '배당소득금액', '0')}${field('otherIncome', '기타소득 총수입금액', '0')}${field('otherIncomeExpense', '기타소득 필요경비', '0')}</div></section>` +
      /* html */ `<section
        class="lg:col-span-2"
        rounded="2xl"
        border="1 border dark:dark-border"
        p="4 md:5"
      >
        <h3 m="0" text="base" font="750">② 소득공제</h3>
        <div grid="~ cols-1 md:cols-2" gap="4" mt="4">
          ${field('dependents', '기본공제 인원', '1', '명', '1')}${field(
            'seniorDependents',
            '70세 이상 추가공제 인원',
            '0',
            '명',
            '1',
          )}${field(
            'disabledDependents',
            '장애인 추가공제 인원',
            '0',
            '명',
            '1',
          )}${field(
            'femaleAdditionalDeduction',
            '부녀자 추가공제',
            '0',
          )}${field('singleParentDeduction', '한부모 추가공제', '0')}${field(
            'pensionInsurance',
            '연금보험료 공제',
            '0',
          )}${field('specialIncomeDeduction', '특별소득공제', '0')}${field(
            'otherIncomeDeduction',
            '기타 소득공제',
            '0',
          )}
        </div>
      </section>` +
      /* html */ `<section
        class="lg:col-span-2"
        rounded="2xl"
        border="1 border dark:dark-border"
        p="4 md:5"
      >
        <h3 m="0" text="base" font="750">③ 세액공제</h3>
        <div grid="~ cols-1 md:cols-2" gap="4" mt="4">
          ${field(
            'children',
            '자녀세액공제 대상 자녀 수',
            '0',
            '명',
            '1',
          )}${field('birthFirst', '출산·입양 첫째', '0', '명', '1')}${field(
            'birthSecond',
            '출산·입양 둘째',
            '0',
            '명',
            '1',
          )}${field(
            'birthThirdPlus',
            '출산·입양 셋째 이상',
            '0',
            '명',
            '1',
          )}${field('pensionAccount', '연금저축·퇴직연금 납입액', '0')}${field(
            'insurance',
            '일반 보장성보험료',
            '0',
          )}${field(
            'disabledInsurance',
            '장애인전용 보장성보험료',
            '0',
          )}${field(
            'medicalSelfEtc',
            '본인·65세 이상·6세 이하·장애인 의료비',
            '0',
          )}${field('infertilityMedical', '난임시술비', '0')}${field(
            'prematureMedical',
            '미숙아·선천성이상아 의료비',
            '0',
          )}${field('otherMedical', '그 밖의 의료비', '0')}${field(
            'actualReimbursement',
            '실손의료보험금',
            '0',
          )}${field('educationSelf', '본인 교육비', '0')}${field(
            'educationDisabled',
            '장애인 특수교육비',
            '0',
          )}${field('educationPreschool', '취학전 아동 교육비', '0')}${field(
            'educationSchool',
            '초·중·고 교육비',
            '0',
          )}${field('educationUniversity', '대학생 교육비', '0')}${field(
            'rentPayment',
            '연간 월세 지급액',
            '0',
          )}${field(
            'standardTaxCredit',
            '표준세액공제(기본 13만원)',
            '130000',
          )}${field('otherTaxCredit', '기타 세액공제·감면', '0')}
        </div>
      </section>` +
      /* html */ `<section
        class="lg:col-span-2"
        rounded="2xl"
        border="1 border dark:dark-border"
        p="4 md:5"
      >
        <h3 m="0" text="base" font="750">④ 기납부·가산세</h3>
        <div grid="~ cols-1 md:cols-2" gap="4" mt="4">
          ${field('withholdingTax', '원천징수세액', '0')}${field(
            'prepaidTax',
            '기납부세액',
            '0',
          )}${field('penaltyTax', '가산세', '0')}
        </div>
      </section>`;

    const calculate = () => {
      const input: IncomeTaxInput = {
        businessIncome: number('businessIncome'),
        wageIncome: number('wageIncome'),
        pensionIncome: number('pensionIncome'),
        interestIncome: number('interestIncome'),
        dividendIncome: number('dividendIncome'),
        otherIncome: number('otherIncome'),
        otherIncomeExpense: number('otherIncomeExpense'),
        dependents: number('dependents'),
        seniorDependents: number('seniorDependents'),
        disabledDependents: number('disabledDependents'),
        femaleAdditionalDeduction: number('femaleAdditionalDeduction'),
        singleParentDeduction: number('singleParentDeduction'),
        pensionInsurance: number('pensionInsurance'),
        specialIncomeDeduction: number('specialIncomeDeduction'),
        otherIncomeDeduction: number('otherIncomeDeduction'),
        children: number('children'),
        birthFirst: number('birthFirst'),
        birthSecond: number('birthSecond'),
        birthThirdPlus: number('birthThirdPlus'),
        pensionAccount: number('pensionAccount'),
        insurance: number('insurance'),
        disabledInsurance: number('disabledInsurance'),
        medicalSelfEtc: number('medicalSelfEtc'),
        infertilityMedical: number('infertilityMedical'),
        prematureMedical: number('prematureMedical'),
        otherMedical: number('otherMedical'),
        actualReimbursement: number('actualReimbursement'),
        educationSelf: number('educationSelf'),
        educationDisabled: number('educationDisabled'),
        educationPreschool: number('educationPreschool'),
        educationSchool: number('educationSchool'),
        educationUniversity: number('educationUniversity'),
        rentPayment: number('rentPayment'),
        standardTaxCredit: number('standardTaxCredit'),
        otherTaxCredit: number('otherTaxCredit'),
        withholdingTax: number('withholdingTax'),
        prepaidTax: number('prepaidTax'),
        penaltyTax: number('penaltyTax'),
      };

      const r = calculateIncomeTax(input);
      result.textContent =
        r.finalTax < 0
          ? `환급 예상 ${money(Math.abs(r.finalTax))}`
          : `납부 예상 ${money(r.finalTax)}`;
      summary.textContent = `종합소득금액 ${money(r.totalIncome)} · 소득공제 ${money(r.totalIncomeDeduction)} · 과세표준 ${money(r.taxableIncome)} · 세율 ${(r.taxRate * 100).toFixed(0)}% · 산출세액 ${money(r.calculatedTax)}`;

      const rows: Array<[string, number]> = [
        ['근로소득공제', r.earnedIncomeDeduction],
        ['연금소득공제', r.pensionIncomeDeduction],
        ['인적·소득공제', r.totalIncomeDeduction],
        ['근로소득세액공제', r.earnedIncomeTaxCredit],
        ['자녀·출산세액공제', r.childTaxCredit],
        ['연금계좌 세액공제', r.pensionAccountTaxCredit],
        ['보험료 세액공제', r.insuranceTaxCredit],
        ['의료비 세액공제', r.medicalTaxCredit],
        ['교육비 세액공제', r.educationTaxCredit],
        ['월세 세액공제', r.rentTaxCredit],
        ['표준/특별세액공제', r.standardOrSpecialTaxCredit],
        ['기타 세액공제·감면', r.otherTaxCredit],
        ['결정세액', r.determinedTax],
        ['납부·환급 조정 후', r.finalTax],
      ];
      breakdown.innerHTML = rows
        .map(
          ([label, amount]) => /* html */ `<div
            rounded="xl"
            border="1 border dark:dark-border"
            p="4"
          >
            <div text="xs text-muted dark:dark-text-muted">${label}</div>
            <div mt="1" font="700">${money(amount)}</div>
          </div>`,
        )
        .join('');
    };

    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        if (input.dataset.defaultValue !== undefined) {
          input.value = input.dataset.defaultValue;
        }
      });
      calculate();
    };

    root
      .querySelector('#income-tax-calculate')
      ?.addEventListener('click', calculate);
    root.querySelector('#income-tax-reset')?.addEventListener('click', reset);
    bindCalculatorInputs(fields, calculate, { change: true });
    calculate();
  }
</script>
