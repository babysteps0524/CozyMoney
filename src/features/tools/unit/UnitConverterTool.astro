<div>
  <p m="0" text="sm" font="700" text-primary>
    UNIT CONVERTER
  </p>
  <h2 m="0" mt="1" text="xl md:2xl" font="800">
    단위 변환기
  </h2>
  <div grid="~ cols-1 md:cols-3" gap="4" mt="6">
    <label>
      <span class="cm-label">분류</span>
      <select id="unit-type" class="cm-input">
        <option value="length">길이</option>
        <option value="weight">무게</option>
        <option value="temperature">온도</option>
        <option value="area">넓이</option>
        <option value="data">데이터</option>
      </select>
    </label>
    <label>
      <span class="cm-label">값</span>
      <input id="unit-value" class="cm-input" type="number" value="1" />
    </label>
    <label>
      <span class="cm-label">변환 방향</span>
      <select id="unit-direction" class="cm-input"></select>
    </label>
  </div>
  <div
    id="unit-result"
    mt="5"
    rounded="2xl"
    bg="surface-muted dark:dark-surface-subtle"
    p="5"
    text="center"
  >
    변환 결과
  </div>
</div>
