<div>
  <p m="0" text="sm" font="700" text-primary>
    RANDOM NUMBER
  </p>
  <h2 m="0" mt="1" text="xl md:2xl" font="800">
    랜덤 숫자 생성기
  </h2>
  <div grid="~ cols-1 md:cols-2" gap="4" mt="6">
    <label>
      <span class="cm-label">최솟값</span>
      <input id="random-min" class="cm-input" type="number" value="1" />
    </label>
    <label>
      <span class="cm-label">최댓값</span>
      <input id="random-max" class="cm-input" type="number" value="100" />
    </label>
  </div>
  <div
    id="random-result"
    mt="6"
    rounded="2xl"
    bg="surface-muted dark:dark-surface-subtle"
    p="6"
    text="center"
  >
    <span text="4xl md:5xl" font="800">
      -
    </span>
  </div>
  <button id="random-generate" class="cm-button-primary" w="full" mt="4" py="3">
    랜덤 숫자 생성
  </button>
</div>
