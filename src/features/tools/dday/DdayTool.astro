<div>
  <p m="0" text="sm" font="700" text-primary>
    D-DAY
  </p>
  <h2 m="0" mt="1" text="xl md:2xl" font="800">
    D-Day 계산기
  </h2>
  <label block mt="6">
    <span class="cm-label">목표 날짜</span>
    <input id="dday-date" class="cm-input" type="date" />
  </label>
  <label block mt="4">
    <span class="cm-label">목표 이름 (선택)</span>
    <input
      id="dday-name"
      class="cm-input"
      placeholder="시험, 여행, 기념일 등"
    />
  </label>
  <div
    id="dday-result"
    mt="5"
    rounded="2xl"
    bg="surface-muted dark:dark-surface-subtle"
    p="6"
    text="center"
  >
    목표 날짜를 선택하세요.
  </div>
  <button id="dday-calc" class="cm-button-primary" w="full" mt="4" py="3">
    D-Day 계산
  </button>
</div>
